WEBCLIP_HOST=127.0.0.1
WEBCLIP_PORT=15080
WEBCLIP_DATA_DIR=/opt/copy-example/data
WEBCLIP_USERNAME=admin
WEBCLIP_PASSWORD=replace-with-a-long-random-password
# Optional after first run: WEBCLIP_PASSWORD_HASH can replace WEBCLIP_PASSWORD.
# The app stores the active password hash in SQLite.
WEBCLIP_PASSWORD_HASH=
WEBCLIP_SESSION_SECRET=replace-with-a-long-random-secret
WEBCLIP_COOKIE_DOMAIN=
WEBCLIP_COOKIE_SECURE=1
WEBCLIP_GO_ONLY_HOSTS=copy.example.com
WEBCLIP_DIRECT_URL=https://copy-direct.example.com
WEBCLIP_CF_URL=https://copy-cf.example.com
WEBCLIP_DEFAULT_TTL_SECONDS=14400
WEBCLIP_MAX_FILE_BYTES=104857600
WEBCLIP_MAX_UPLOAD_BYTES=115343360
WEBCLIP_PINNED_LIMIT_BYTES=5368709120
WEBCLIP_TEMP_LIMIT_BYTES=2147483648
WEBCLIP_DISK_HIGH_WATER=0.80
